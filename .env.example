# =============================================================================
# Préstamo de Equipos Apiux - Environment Variables
# =============================================================================
# Copiar este archivo a .env y configurar los valores correspondientes.
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=prestamo_equipos

# -----------------------------------------------------------------------------
# Backend Application
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=8000

# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:25173

# -----------------------------------------------------------------------------
# Azure AD Authentication
# -----------------------------------------------------------------------------
# Client ID from Azure App Registration
AZURE_AD_CLIENT_ID=your-azure-ad-client-id

# Client Secret from Azure App Registration
AZURE_AD_CLIENT_SECRET=your-azure-ad-client-secret

# Tenant ID from Azure Active Directory
AZURE_AD_TENANT_ID=your-azure-ad-tenant-id

# Redirect URI for Azure AD callback
# Development:
AZURE_AD_REDIRECT_URI=http://localhost:25173/api/auth/azure/callback
# Production (GCP):
# AZURE_AD_REDIRECT_URI=https://your-gcp-domain.com/api/auth/azure/callback

# -----------------------------------------------------------------------------
# Email Notifications (Opcional)
# -----------------------------------------------------------------------------
# SMTP configuration for email notifications
SMTP_HOST=smtp.api-ux.com
SMTP_PORT=587
SMTP_USER=notifications@api-ux.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=Equipos Apiux <notifications@api-ux.com>

# -----------------------------------------------------------------------------
# GCP Configuration (Producción)
# -----------------------------------------------------------------------------
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_REGION=us-central1
# GCP_CLOUD_SQL_INSTANCE=your-sql-instance
